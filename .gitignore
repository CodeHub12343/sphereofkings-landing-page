# Intermediate extraction artifacts from converting the original bundled design
extracted/

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log

# TypeScript incremental build artifact
nextjs/tsconfig.tsbuildinfo

# Local dev launch config (preview_start)
.claude/launch.json

# Recovered-subscriber lists — contain real PII, must never leave the dev box.
# Belongs in the Mongo subscribers collection, imported via import-subscribers.mjs.
nextjs/scripts/recovered-subscribers.txt
nextjs/scripts/recovered-gmail.txt
nextjs/scripts/gmail-oct17-batch.txt
nextjs/scripts/*-batch.txt

# Walkthrough recordings — big binary files, regenerate on demand.
nextjs/scripts/walkthrough-output/

# Generated docs (docx/pdf) — regenerate via scripts/docs/build-*.mjs.
# Word lock files (~$*) must never be committed either.
nextjs/scripts/docs/*.docx
nextjs/scripts/docs/*.pdf
nextjs/scripts/docs/~$*

# Any top-level .env file (defense-in-depth; the nextjs/.gitignore already
# covers nextjs/.env*.local, this blocks any .env anywhere in the repo).
.env
.env.*
!.env.example
