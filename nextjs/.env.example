# Admin bootstrap. These env vars seed the FIRST owner account the
# moment the admin users collection is empty — after that, add new
# operators from the admin UI with per-account passwords, and rotate
# this seed password out.
#
# Without MONGODB_URI below, these two also drive the HTTP Basic
# fallback so dev-without-Mongo still works.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Session-token secret. Any random string ≥ 32 bytes. Used to HMAC the
# admin and affiliate session cookies — rotate this and every active
# session invalidates on the next request.
#
# Generate one: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=replace-me-with-at-least-32-random-bytes

# Stripe. Set all three to enable real payments and the real finance
# adapter. Leave any blank to keep the honest "Stripe not wired" state
# at checkout and the MockStripeAdapter on /admin/finance.
#
# Grab test keys from https://dashboard.stripe.com/test/apikeys
# The webhook secret comes from the webhook endpoint you add in
# Stripe pointing at https://<your-domain>/api/stripe/webhook
#STRIPE_SECRET_KEY=sk_test_...
#NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
#STRIPE_WEBHOOK_SECRET=whsec_...

# MongoDB persistence. When MONGODB_URI is set, every store (quotes,
# finance, subscribers, …) reads and writes through it. Leave it unset
# in dev to fall back to the file-backed stores in nextjs/.data.
#
# Example (local): mongodb://127.0.0.1:27017
# Example (Atlas): mongodb+srv://user:pass@cluster.mongodb.net
#MONGODB_URI=mongodb://127.0.0.1:27017
#MONGODB_DB=sphereofkings
